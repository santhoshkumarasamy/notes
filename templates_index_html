<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentation</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f4f7fb;
            --card: #ffffff;
            --primary: #2563eb;
            --primary-light: #dbeafe;
            --text: #1f2937;
            --muted: #6b7280;
            --border: #e5e7eb;
            --code-bg: #0f172a;
            --success: #16a34a;
            --warning: #f59e0b;
            --danger: #dc2626;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
        }

        .container {
            max-width: 1000px;
            margin: 50px auto;
            padding: 30px;
        }

        /* Hero */

        .hero {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            padding: 45px;
            border-radius: 18px;
            margin-bottom: 35px;
            box-shadow: 0 15px 35px rgba(37,99,235,.25);
        }

        .hero h1 {
            font-size: 2.8rem;
            margin-bottom: 10px;
        }

        .hero p {
            opacity: .95;
            font-size: 1.1rem;
        }

        .badge {
            display: inline-block;
            background: rgba(255,255,255,.18);
            color: white;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: .85rem;
            font-weight: 600;
            margin-bottom: 15px;
        }

        /* Section */

        .section {
            background: var(--card);
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 8px 25px rgba(0,0,0,.05);
            border: 1px solid var(--border);
        }

        .section h2 {
            color: var(--primary);
            margin-bottom: 18px;
        }

        .section h3 {
            margin-top: 25px;
            margin-bottom: 10px;
        }

        .section p {
            margin: 12px 0;
        }

        ul, ol {
            margin: 15px 0 15px 25px;
        }

        li {
            margin: 8px 0;
        }

        /* Alerts */

        .tip,
        .note,
        .warning {
            padding: 18px;
            border-radius: 10px;
            margin: 20px 0;
        }

        .tip {
            background: #ecfdf5;
            border-left: 5px solid var(--success);
        }

        .note {
            background: #fff8db;
            border-left: 5px solid var(--warning);
        }

        .warning {
            background: #fef2f2;
            border-left: 5px solid var(--danger);
        }

        /* Code */

        pre {
            background: var(--code-bg);
            color: #e2e8f0;
            padding: 20px;
            border-radius: 12px;
            overflow-x: auto;
            margin: 18px 0;
            font-size: 15px;
        }

        code {
            font-family: "JetBrains Mono", monospace;
        }

        .inline {
            background: #eef2ff;
            color: #1d4ed8;
            padding: 2px 8px;
            border-radius: 6px;
            font-family: "JetBrains Mono", monospace;
            font-size: .95em;
        }

        hr {
            border: none;
            border-top: 1px solid var(--border);
            margin: 30px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        table th,
        table td {
            border: 1px solid var(--border);
            padding: 12px;
            text-align: left;
        }

        table th {
            background: #f8fafc;
        }

        .footer {
            text-align: center;
            color: var(--muted);
            margin: 40px 0;
        }

        @media (max-width:768px){

            .container{
                padding:15px;
            }

            .hero{
                padding:30px;
            }

            .hero h1{
                font-size:2rem;
            }

            .section{
                padding:22px;
            }

        }
    </style>

</head>

<body>

<div class="container">

    <!-- ===================================================== -->
    <!-- HERO -->
    <!-- ===================================================== -->

    <div class="hero">
        <span class="badge">Category</span>

        <h1>Documentation Title</h1>

        <p>
            Small description about this document.
        </p>
    </div>



    <!-- ===================================================== -->
    <!-- SECTION TEMPLATE -->
    <!-- Duplicate this block whenever needed -->
    <!-- ===================================================== -->

    <div class="section">

        <h2>📌 Section Title</h2>

        <p>
            Write your explanation here.
        </p>

        <div class="tip">
            <strong>Tip:</strong>
            Helpful information.
        </div>

        <div class="note">
            <strong>Note:</strong>
            Important information.
        </div>

        <div class="warning">
            <strong>Warning:</strong>
            Things users should be careful about.
        </div>

        <h3>Sub Heading</h3>

        <p>
            More explanation...
        </p>

        <ul>
            <li>Point One</li>
            <li>Point Two</li>
            <li>Point Three</li>
        </ul>

<pre><code># Example Code

echo "Hello World"</code></pre>

        <p>
            Inline command:
            <span class="inline">ansible-playbook</span>
        </p>

        <table>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>

            <tr>
                <td>Example</td>
                <td>Description</td>
            </tr>
        </table>

        <hr>

        <h3>Another Example</h3>

<pre><code># Another code block</code></pre>

    </div>



    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <div class="footer">
        Documentation Template
    </div>

</div>

</body>
</html>